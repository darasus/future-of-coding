{
  "name": "future-of-coding",
  "version": "0.1.0",
  "private": true,
  "description": "A voice-driven desktop board for running Claude coding agents",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:unpack": "electron-vite build && electron-builder --mac --dir",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@effect/sql-sqlite-node": "4.1.7",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@1a36210",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@7bff56b",
    "effect": "^4.1.7",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "author": "Ilya Daraseliya",
  "license": "MIT"
}
